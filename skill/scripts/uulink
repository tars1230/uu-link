#!/bin/bash
# uulink — 用 UU 远程的端口映射，一键建立到某台设备的 SSH 通路
#
# 背景（都是实测出来的，别再踩）：
#   · 映射规则只能在 UU 图形界面里加（CLI 没有这个命令）
#   · 本地监听只在「有会话」时存在
#   · 【坑】`device disconnect` 会把端口变成"幽灵监听"：TCP 还能连上，
#          后端已经死了，SSH 卡在 banner。这个幽灵从命令行清不掉，
#          只能等新会话顶上去，或重启 UU（重启后还要手动把映射开关重置一次）
#   · 【因此】判断"通不通"绝不能只看 TCP 能连，必须读到 SSH banner
#   · 关掉终端窗口不影响映射（映射挂在会话上，不挂在窗口上）
#   · 【坑】链路死掉时 UU 本地代理仍让 socket 保持 ESTABLISHED，ssh 既不报错也不
#          超时 ⇒ -o ServerAliveInterval 探不到 ⇒ 进程永不退出 ⇒ launchd 的
#          KeepAlive 永不触发（它只管"进程死了再拉起"）。所以看护必须做 banner 级。
#
# 用法：
#   uulink                 体检（只读）
#   uulink check [名称]    体检；带名称只查那一条
#   uulink list            列出 UU 账号里的设备与在线状态
#   uulink up [名称]       确保通路（必要时 term open 建轻会话）
#   uulink ssh [名称] [命令...]   直连；不带命令进交互 shell
#   uulink down            解释为什么"关掉单向连接"不该做
#   uulink down [名称] --force [-y]   重启 UU 清掉幽灵端口（会断所有远控）
#   uulink watch [--once] [--quiet]   看护一轮：banner 检测 + 自愈（给 launchd 用）
#   uulink watch --install | --uninstall   装/卸每分钟一次的看护常驻
#
set -uo pipefail

# UU 客户端 CLI：优先环境变量，其次脚本同级目录，最后 macOS 应用包内
UUCLI="${UU_LINK_CLI:-}"
if [ -z "$UUCLI" ]; then
  _self_dir="$(cd "$(dirname "$0")" && pwd)"
  if [ -x "$_self_dir/uuyc-cli" ]; then
    UUCLI="$_self_dir/uuyc-cli"
  else
    UUCLI="/Applications/UURemote.app/Contents/Helpers/uuyc-cli"
  fi
fi
CFG="$HOME/.config/uulink/devices.tsv"
KH="$HOME/.config/uulink/known_hosts"
PY="$(command -v python3 || echo /usr/bin/python3)"
# 看护在 launchd 下跑时不许碰 System Events（会弹「自动化」授权框，且无人可点）
NO_OSA=0

die() { printf '\033[31m✗ %s\033[0m\n' "$*" >&2; exit 1; }
ok()  { printf '\033[32m✓ %s\033[0m\n' "$*"; }
warn(){ printf '\033[33m! %s\033[0m\n' "$*"; }
info(){ printf '  %s\n' "$*"; }

[ -x "$UUCLI" ] || die "找不到 uuyc-cli：${UUCLI}（可用 UU_LINK_CLI 指定路径）"

# 所有 CLI 调用都带 20s 超时——UU 客户端偶发不返回时，不能把整个 up 挂死
uu() {
  "$PY" - "$UUCLI" "$@" <<'PY' 2>&1
import subprocess, sys
try:
    r = subprocess.run(sys.argv[1:], capture_output=True, text=True, timeout=20)
except subprocess.TimeoutExpired:
    print("uuyc-cli 超时(20s)", file=sys.stderr)
    sys.exit(124)
sys.stdout.write(r.stdout)
sys.stderr.write(r.stderr)
sys.exit(r.returncode)
PY
}

# 只保留 JSON 里的 success / error.message，避免把整包响应（可能含设备信息）打出来
uu_msg() { printf '%s' "$1" | "$PY" -c '
import json,sys
raw=sys.stdin.read()
try: o=json.loads(raw)
except Exception: print(raw.strip()[:200]); raise SystemExit
d=o.get("data") or {}; e=o.get("error") or {}
print(d.get("message") or e.get("message") or ("success" if o.get("success") else "失败"))'; }

# ---------- 配置 ----------
ensure_cfg() {
  local d; d="$(dirname "$CFG")"
  mkdir -p "$d"
  chmod 700 "$d" 2>/dev/null
  [ -f "$CFG" ] && { chmod 600 "$CFG" 2>/dev/null; return; }
  cat > "$CFG" <<'EOF'
# name	deviceId	localport	sshuser	key
# deviceId 写 - 表示每次从 device list 按名称自动取
# 多台设备请用不同 localport，避免抢端口
# 下面这行是模板，改成你自己的设备后去掉行首的 #
# office-pc	-	2222	administrator	~/.ssh/id_ed25519
EOF
  chmod 600 "$CFG" 2>/dev/null
}

list_devices() {
  uu device list | "$PY" -c '
import json,sys
try: d=json.load(sys.stdin)["data"]["devices"]
except Exception: sys.exit(1)
for x in d:
    print("%s\t%s\t%s" % (x.get("deviceName",""), x.get("deviceId",""),
                          "1" if x.get("isOnline") else "0"))
'
}

resolve_id() {
  local id
  id=$(list_devices | awk -F'\t' -v w="$1" 'tolower($1)==tolower(w){print $2; exit}')
  [ -n "$id" ] || return 1
  printf '%s' "$id"
}

cfg_field() { # $1=名称 $2=列号；找不到返回非 0
  [ -f "$CFG" ] || return 1
  local v
  v=$(awk -F'\t' -v w="$1" -v c="$2" '
    /^[[:space:]]*#/ {next} NF>=5 && tolower($1)==tolower(w) {print $c; exit}' "$CFG")
  [ -n "$v" ] || return 1
  printf '%s' "$v"
}

configured_online() {
  local n _ on
  while IFS=$'\t' read -r n _ on; do
    [ "$on" = "1" ] || continue
    cfg_field "$n" 3 >/dev/null 2>&1 && printf '%s\n' "$n"
  done < <(list_devices)
}

# 未指定设备时：唯一候选才自动选，多个候选必须点名（避免静默操作错设备）
pick_name() {
  local list count
  list=$(configured_online)
  count=$(printf '%s\n' "$list" | grep -c . || true)
  [ "$count" -ge 1 ] || return 1
  if [ "$count" -gt 1 ]; then
    printf '\033[33m! 有 %s 台设备可用，请点名：\033[0m\n' "$count" >&2
    printf '  %s\n' $list >&2
    return 2
  fi
  printf '%s' "$list"
}

# ---------- 健康判定 ----------
port_listening() { lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1; }

# 只看监听会被幽灵骗，必须读到协议层 banner。
# 注意：强绑定 SSH 协议；若映射目标不是 SSH 服务，会判为不通。
chan_ok() {
  "$PY" - "$1" <<'PY' 2>/dev/null
import socket, sys
port = int(sys.argv[1])
try:
    s = socket.create_connection(("127.0.0.1", port), timeout=6)
except Exception:
    sys.exit(1)
s.settimeout(6)
try:
    head = s.recv(64)
except Exception:
    sys.exit(1)
finally:
    try: s.close()
    except Exception: pass
sys.exit(0 if head.startswith(b"SSH-") else 1)
PY
}

wait_chan() { # $1=port $2=墙钟超时秒（按真实时间，不按循环次数）
  local p="$1" t="${2:-90}" deadline remaining
  deadline=$(( $(date +%s) + t ))
  while :; do
    remaining=$(( deadline - $(date +%s) ))
    [ $remaining -gt 0 ] || return 1
    chan_ok "$p" && return 0
    [ $remaining -gt 1 ] && sleep 1
  done
}

# 只关 UU 自己的 sessionN 窗口（清理，不影响映射），不碰别的应用
close_session_windows() {
  [ "$NO_OSA" = "1" ] && return 0
  osascript <<'OSA' 2>/dev/null
tell application "System Events"
  if not (exists process "UURemote") then return
  tell process "UURemote"
    repeat with w in (every window)
      try
        set nm to name of w
        if nm is not missing value then
          if nm starts with "session" and (length of nm) is less than 10 then
            perform action "AXPress" of (first button of w whose subrole is "AXCloseButton")
          end if
        end if
      end try
    end repeat
  end tell
end tell
OSA
}

# ---------- 动作 ----------
cmd_list() {
  local n id on mark tag p
  printf '%-14s %-20s %s\n' "设备" "ID" "状态"
  while IFS=$'\t' read -r n id on; do
    [ -n "$n" ] || continue
    mark="离线"; [ "$on" = "1" ] && mark=$'\033[32m在线\033[0m'
    tag=""; p=$(cfg_field "$n" 3 2>/dev/null); [ -n "$p" ] && tag="  ← 已配通路 :$p"
    printf '%-14s %-20s %b%s\n' "$n" "$id" "$mark" "$tag"
  done < <(list_devices)
}

cmd_check() {
  local only="${1:-}"
  [ -n "$only" ] && { cfg_field "$only" 3 >/dev/null || die "${only} 不在 $CFG 里，先加一行"; }
  echo "── UU ──"
  uu status | "$PY" -c '
import json,sys
try: d=json.load(sys.stdin)["data"]
except Exception: print("  无法解析 uuyc-cli status"); raise SystemExit
print("  版本 %s  登录 %s  网络 %s" % (d.get("appVersion"), d.get("isLoggedIn"), d.get("networkStatus")))'
  echo "── 设备 ──"; cmd_list
  echo "── 通路 ──"
  local name _ port found=0
  while IFS=$'\t' read -r name _ port _ _; do
    case "$name" in \#*|"") continue;; esac
    [ -n "${port:-}" ] || continue
    if [ -n "$only" ] && [ "$name" != "$only" ]; then continue; fi
    found=1
    if chan_ok "$port"; then
      ok "$name  127.0.0.1:$port 真通"
    elif port_listening "$port"; then
      warn "$name  127.0.0.1:$port 幽灵监听（端口在、后端死）→ uulink up ${name}"
    else
      info "$name  127.0.0.1:$port 无监听 → uulink up ${name}"
    fi
  done < <(grep -v '^[[:space:]]*#' "$CFG" 2>/dev/null || true)
  [ $found -eq 1 ] || info "还没配设备：编辑 ${CFG}（模板里有格式），或先 uulink list 看设备名"
  local lr fails loaded=0 age=0 lst=""
  launchctl list "$WATCH_LABEL" >/dev/null 2>&1 && loaded=1
  if [ $loaded -eq 1 ]; then
    # 上轮的退出码。看护本身崩了（比如变量未定义）时 loaded 仍然是 1，
    # 只查 loaded 会让人以为"装好了在跑"，实际每轮都在退出
    lst=$(launchctl list "$WATCH_LABEL" 2>/dev/null | sed -n 's/.*"LastExitStatus" *= *\([0-9-]*\).*/\1/p' | head -1)
  fi
  lr=$(cat "$LASTF" 2>/dev/null)
  if [ $loaded -eq 1 ] && [ -n "${lr:-}" ]; then
    age=$(( $(date +%s) - lr ))
    info "看护：上次运行 $(date -r "$lr" '+%m-%d %H:%M:%S' 2>/dev/null || echo "$lr")（${age}s 前，日志 ${WLOG}）"
    # 定时器 60s 一轮：超过 5 轮没更新 = 停摆了，而 launchctl 仍说"已加载"
    [ "$age" -gt 300 ] && warn "看护：已 ${age}s 没运行（超过 5 个周期），疑似停摆 → launchctl kickstart -k gui/$(id -u)/${WATCH_LABEL}"
    if [ -n "${lst:-}" ] && [ "${lst}" != "0" ]; then
      warn "看护：上轮退出码 ${lst}（非 0）→ 看 ${WERR}"
    fi
    while IFS=$'\t' read -r name _ port _ _; do
      case "${name:-}" in ''|\#*) continue;; esac
      fails=$(awk -F'\t' -v n="$name" '$1==n{print ($2 ~ /^[0-9]+$/ ? $2 : 0); exit}' "$STATE" 2>/dev/null)
      [ "${fails:-0}" -gt 0 ] 2>/dev/null && warn "  $name 已尝试补救 ${fails} 次仍失败（看护在退避重试）"
    done < <(grep -v '^[[:space:]]*#' "$CFG" 2>/dev/null || true)
  elif [ $loaded -eq 1 ]; then
    info "看护：已加载但还没跑完一轮（等 60s 再看）"
  elif [ -f "$WATCH_PLIST" ]; then
    info "看护：plist 在但没加载（launchctl bootstrap gui/$(id -u) ${WATCH_PLIST}）"
  else
    info "看护未启用：uulink watch --install（每分钟 banner 检测，断了自动修）"
  fi
  return 0   # 体检只是报告，健康也不代表"命令失败"；这里以前漏了，会让 install.sh 自检误判
}

cmd_up() {
  local name="${1:-}" port id ghost=0 rc
  if [ -z "$name" ]; then
    name=$(pick_name); rc=$?
    [ $rc -eq 2 ] && exit 2
    [ $rc -eq 0 ] || die "没有在线且已配置的设备；先 uulink list 看状态"
  fi
  port=$(cfg_field "$name" 3) || die "${name} 不在 $CFG 里，先加一行"
  id=$(resolve_id "$name") || die "UU 设备列表里找不到「${name}」"

  if chan_ok "$port"; then
    ok "$name 通路已在 127.0.0.1:$port"
  else
    port_listening "$port" && ghost=1
    [ $ghost -eq 1 ] && warn "端口在监听但后端不通（幽灵），先试新会话顶替"
    info "建立轻会话（term open，不拉整块桌面）"
    local r; r=$(uu term open "$id")
    if ! printf '%s' "$r" | grep -q '"success" *: *true'; then
      warn "term open 失败：$(uu_msg "$r")"
      die "会话没建起来（设备可能离线，先 uulink list）"
    fi

    info "等待通路就绪（最多 90s）…"
    if wait_chan "$port" 90; then
      ok "通路就绪"
      close_session_windows
    else
      cat <<EOF
$(printf '\033[33m! 会话开了但 90s 内没读到 SSH banner\033[0m')

按概率排查：
  1. 【最常见】UU 冷启动后规则显示"✓ 成功"但端口不绑 → 打开「端口映射」面板，
     把那条开关关一次、再开一次，端口立刻回来（重启 UU 后必然要补这一步）
  2. 规则不存在 → 同一面板「添加」：先选中目标设备，再填
     本地 ${port} / 目标 127.0.0.1 / 目标端口 22
  3. 幽灵端口卡死 → uulink down ${name} --force（重启 UU，之后仍要按第 1 条重绑）
  4. 被控端 sshd 没跑
EOF
      exit 3
    fi
  fi
  echo; ok "现在可以： uulink ssh ${name}"
}

cmd_down() {
  local force=0 yes=0 name="" port="" id="" arg
  for arg in "$@"; do
    case "$arg" in
      --force) force=1 ;;
      -y|--yes) yes=1 ;;
      *) name="$arg" ;;
    esac
  done
  if [ -z "$name" ]; then
    # --force 会断所有远控，绝不允许自动挑一台就执行
    [ $force -eq 1 ] && die "--force 必须写清设备名（uulink down <名称> --force）"
    name=$(pick_name); local rc=$?
    [ $rc -eq 2 ] && exit 2
    [ $rc -eq 0 ] || die "没指定设备"
  fi
  port=$(cfg_field "$name" 3 2>/dev/null) || port=""
  id=$(resolve_id "$name") || die "UU 设备列表里找不到「${name}」"

  if [ $force -eq 0 ]; then
    cat <<EOF
不要用"关掉单向连接"来避端口冲突——三条路都试过，全部无效：
  · \`device disconnect\`：端口不退，而且会变成幽灵监听（后端死、TCP 仍可连）
  · \`term exit\`：帮助原文"会话保留"
  · 关窗口：不影响会话（映射挂在会话上）

正确做法：给每台设备分配不同的 localport（${CFG}），
多台可同时在线、互不干扰，根本不需要关。

真要清掉 ${port}：uulink down ${name} --force
EOF
    return 0
  fi

  warn "这会强制退出 UU 客户端，切断本机所有正在进行的远控（包括别人正连着你这台）"
  if [ $yes -eq 0 ]; then
    if [ -t 0 ]; then
      printf '  确认继续？[y/N] '
      read -r ans
      case "${ans:-}" in y|Y|yes|YES) ;; *) info "已取消"; return 1;; esac
    else
      # 非交互（脚本/agent）必须显式 -y，否则一律不执行
      die "非交互环境不会自动确认，要执行请显式加 -y：uulink down ${name} --force -y"
    fi
  fi

  info "退出 UU …"
  osascript -e 'tell application id "com.netease.uuremote" to quit' 2>&1 | head -2
  local i=0
  while [ $i -lt 20 ]; do pgrep -x UURemote >/dev/null 2>&1 || break; sleep 0.5; i=$((i+1)); done
  if pgrep -x UURemote >/dev/null 2>&1; then
    warn "UU 没退出干净，再等 5 秒"
    sleep 5
    pgrep -x UURemote >/dev/null 2>&1 && die "UU 仍在运行，请手动退出后重试（端口未释放）"
  fi

  info "重新拉起 UU …"
  if ! open -a UURemote; then
    sleep 2
    open -a UURemote || die "UU 现在处于关闭状态且拉不起来，请手动打开应用"
  fi
  i=0
  while [ $i -lt 40 ]; do pgrep -x UURemote >/dev/null 2>&1 && break; sleep 0.5; i=$((i+1)); done
  pgrep -x UURemote >/dev/null 2>&1 || die "UU 进程没回来，请手动打开应用"

  i=0
  while [ $i -lt 40 ]; do port_listening "$port" || break; sleep 0.5; i=$((i+1)); done
  if port_listening "$port"; then
    printf '  占用进程：%s\n' "$(lsof -nP -iTCP:"$port" -sTCP:LISTEN | tail -n +2 | awk '{print $1"("$2")"}' | paste -sd' ' -)"
    warn "端口 ${port} 仍被占（UU 已重启，但监听还在）"
  else
    ok "端口 ${port} 已无监听（通路是否可用还需 uulink check 看真通）"
  fi
  warn "注意：UU 重启后映射规则会显示「✓ 成功」但端口不绑 —— 去端口映射面板把开关关一次再开一次"
}

cmd_ssh() {
  local name="${1:-}" port user key rc
  shift 2>/dev/null || true
  if [ -z "$name" ]; then
    name=$(pick_name); rc=$?
    [ $rc -eq 2 ] && exit 2
    [ $rc -eq 0 ] || die "没有可用设备"
  fi
  port=$(cfg_field "$name" 3); user=$(cfg_field "$name" 4); key=$(cfg_field "$name" 5)
  [ -n "$port" ] || die "${name} 未配置"
  chan_ok "$port" || { info "通路不通，先自动 up…"; cmd_up "$name" >/dev/null 2>&1 || die "up 失败，跑 uulink check 看细节"; }

  mkdir -p "$(dirname "$KH")"; chmod 700 "$(dirname "$KH")" 2>/dev/null
  [ -f "$KH" ] || : > "$KH"; chmod 600 "$KH" 2>/dev/null
  # known_hosts 隔离：不同设备都走 127.0.0.1，共用全局文件会撞 host key
  local sshargs=(-p "$port" -o IdentitiesOnly=yes
                 -o StrictHostKeyChecking=accept-new
                 -o "UserKnownHostsFile=$KH"
                 -o ConnectTimeout=10 -o ServerAliveInterval=30 -o ServerAliveCountMax=3
                 -o ControlMaster=auto -o "ControlPath=$HOME/.ssh/cm-%r@%h-%p" -o ControlPersist=15m)
  [ -n "$key" ] && sshargs+=(-i "${key/#\~/$HOME}")
  exec ssh "${sshargs[@]}" "$user@127.0.0.1" "$@"
}

# ---------- 看护（banner 级健康检查 + 自愈） ----------
# 为什么非得 banner 级：链路死时 UU 代理仍让 socket 保持 ESTABLISHED，ssh 写进去
# 不报错也不超时 ⇒ ServerAliveInterval 探不到 ⇒ 进程不退出 ⇒ KeepAlive 不触发。
# 实测：反向隧道曾这样"假装活着"空转 20 分钟，同时在对端留下幽灵监听。
STATE="$HOME/.config/uulink/watch.state"    # 每行：名称<TAB>连续失败数<TAB>上次尝试epoch
WLOG="$HOME/.config/uulink/watch.log"       # 人读的流水账
WERR="$HOME/.config/uulink/watch.err"       # launchd 的 stderr 落点，wlog 轮转它时要读
TUNNELS="$HOME/.config/uulink/tunnels.tsv"  # 每行：设备名<TAB>launchd标签
LOCKD="$HOME/.config/uulink/watch.lock"      # 目录锁（mkdir 原子），见 acquire_lock
LASTF="$HOME/.config/uulink/watch.last"      # 最近一次运行时刻；单独存，避免和设备名撞键
WATCH_PLIST="$HOME/Library/LaunchAgents/com.uulink.watch.plist"
WATCH_LABEL="com.uulink.watch"

watch_state() { # $1=名称 → 输出 fails<TAB>last_attempt（两列都强制为数字）
  [ -f "$STATE" ] || { printf '0\t0'; return; }
  # 必须校验：状态文件被手改或写坏时，$(( )) 会把非数字当成变量名，set -u 下直接崩
  awk -F'\t' -v n="$1" '
    $1==n { a=$2; b=$3; hit=1; exit }
    END {
      if (a !~ /^[0-9]+$/) a=0
      if (b !~ /^[0-9]+$/) b=0
      printf "%s\t%s\n", a, b
    }' "$STATE"
}

watch_put() { # $1=名称 $2=fails $3=last_attempt
  local tmp; mkdir -p "$(dirname "$STATE")"
  tmp="$STATE.$$"
  { [ -f "$STATE" ] && awk -F'\t' -v n="$1" '$1!=n' "$STATE"; printf '%s\t%s\t%s\n' "$1" "$2" "$3"; } >"$tmp" \
    && mv -f "$tmp" "$STATE"
}

# 锁只用 mkdir：它是内核保证原子的，不需要"创建 + 写内容"两步。
# 关键取舍：**判据只看目录年龄，不判进程活没活**。
#   · 不判 pid 存活 → 彻底没有 PID 被复用后"锁永远被占、看护静默停摆"这个失效模式
#   · 代价是崩溃留下的锁要等 LOCK_STALE 才回收（由定时器兜底，可接受）
#   · owner 文件只用来回答"这把锁是不是我建的"，不参与"该不该抢"的决策
#   · 长跑实例必须 lock_touch 续命，否则真活着的会被当陈旧锁回收
LOCK_STALE=600    # 秒。一轮最长约 90s，留足余量
LOCKTOK=""        # 本实例的锁令牌，acquire_lock 成功后才有值

lock_age() {
  local m
  m=$(stat -f %m "$LOCKD" 2>/dev/null) || return 1
  printf '%s' $(( $(date +%s) - m ))
}

# 抢到锁后写入本实例令牌。令牌必须唯一到"同一 pid 不同时刻"也能区分，
# 光用 $$ 会在 PID 复用时误判成"还是我的"。
lock_take() {
  LOCKTOK="$$.$(date +%s).${RANDOM:-0}"
  [ -d "$LOCKD" ] || return 1
  printf '%s\n' "$LOCKTOK" >"$LOCKD/owner" 2>/dev/null || true
  printf '%s\n' "$$" >"$LOCKD/pid" 2>/dev/null || true
  return 0
}

# mkdir 失败有两种含义，必须分开：目录已存在 = 别人在跑（正常跳过）；
# 其它（权限、只读盘、ENOSPC）= 真故障，静默 return 会让看护永久停摆且无痕迹。
lock_busy_or_broken() {
  [ -d "$LOCKD" ] && return 0      # 真的是别人占着
  wlog "取锁失败，且锁目录不存在（权限/磁盘问题？）→ 本轮跳过"
  return 1
}

acquire_lock() {
  if mkdir "$LOCKD" 2>/dev/null; then
    lock_take
    return 0
  fi
  local age
  if ! age=$(lock_age); then          # 目录刚消失（上一轮恰好结束），直接重抢
    mkdir "$LOCKD" 2>/dev/null || { lock_busy_or_broken; return 1; }
    lock_take
    return 0
  fi
  [ "$age" -gt "$LOCK_STALE" ] || return 1    # 还新鲜，当别人在用

  # 回收陈旧锁：先原子搬走再核年龄。若搬到一半发现它其实是别人刚建的新锁（年龄不符），
  # 必须原样放回；但**放回前要确认 LOCKD 还没被别人重新建好**，
  # 否则 mv 会把 aside 整个塞进 LOCKD/aside 变成垃圾目录（老版本的 bug）。
  local aside="$LOCKD.stale.$$" m2
  rm -rf "$aside" 2>/dev/null
  mv "$LOCKD" "$aside" 2>/dev/null || return 1
  m2=$(stat -f %m "$aside" 2>/dev/null || echo "$(date +%s)")
  if [ $(( $(date +%s) - m2 )) -le "$LOCK_STALE" ]; then
    if [ -e "$LOCKD" ]; then
      rm -rf "$aside"
    else
      mv "$aside" "$LOCKD" 2>/dev/null || rm -rf "$aside"
    fi
    return 1
  fi
  rm -rf "$aside"
  mkdir "$LOCKD" 2>/dev/null || { lock_busy_or_broken; return 1; }
  lock_take
  return 0
}

# 这把锁是不是我建的（令牌比对，不是为了"该不该抢"做决策）
lock_is_mine() {
  [ -n "${LOCKTOK:-}" ] || return 1
  [ "$(cat "$LOCKD/owner" 2>/dev/null)" = "$LOCKTOK" ]
}

# 长跑实例续命：不刷新 mtime，跑过 LOCK_STALE 就会被下一轮当陈旧锁回收
lock_touch() { [ -d "$LOCKD" ] && touch "$LOCKD" 2>/dev/null; return 0; }

# 动真格之前确认锁还是自己的，防止极端并发下两轮同时自愈
lock_still_mine() { lock_is_mine; }

wlog() {
  mkdir -p "$(dirname "$WLOG")"
  # 200KB 轮转一份，别让它无限长；stderr 由 launchd 直写，同样要管
  local f
  for f in "$WLOG" "$WERR"; do
    if [ -f "$f" ] && [ "$(wc -c <"$f" 2>/dev/null || echo 0)" -gt 204800 ]; then
      mv -f "$f" "$f.1"
    fi
  done
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$WLOG" 2>/dev/null || true
}

kick_tunnels() { # $1=设备名：把依赖这条通路的常驻隧道重启（踢掉死 socket 上的旧连接）
  local n lab
  [ -f "$TUNNELS" ] || return 0
  while IFS=$'\t' read -r n lab; do
    case "${n:-}" in ''|\#*) continue;; esac
    [ "$(printf '%s' "$n" | tr '[:upper:]' '[:lower:]')" = "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" ] || continue
    [ -n "${lab:-}" ] || continue
    if launchctl kickstart -k "gui/$(id -u)/$lab" >/dev/null 2>&1; then
      wlog "  kickstart $lab"
    else
      wlog "  kickstart $lab 失败（标签不存在或未 bootstrap）"
    fi
  done < <(grep -v '^[[:space:]]*#' "$TUNNELS" 2>/dev/null || true)
  return 0
}

try_open() { # $1=设备名 $2=端口 $3=id → 0=已通
  local r
  r=$(uu term open "$3")
  if ! printf '%s' "$r" | grep -q '"success" *: *true'; then
    wlog "  term open 失败：$(uu_msg "$r")"
    return 1
  fi
  wlog "  term open 成功，等 banner（最多 45s）"
  if wait_chan "$2" 45; then
    # 手动在终端里跑就顺手把拉起的终端窗口关掉；launchd 下 NO_OSA=1 会自动跳过
    close_session_windows
    return 0
  fi
  return 1
}

cmd_watch() {
  local once=0 quiet=0 install=0 uninstall=0 a
  local name _ port id fails last gap devlist now rc
  for a in "$@"; do
    case "$a" in
      --once) once=1 ;;
      -q|--quiet) quiet=1 ;;
      --install) install=1 ;;
      --uninstall) uninstall=1 ;;
      *) die "watch 不认识参数：$a" ;;
    esac
  done
  [ $install -eq 1 ] && { watch_install; return $?; }
  [ $uninstall -eq 1 ] && { watch_uninstall; return $?; }

  # 只有"没人看着"的时候才禁 osascript：launchd 没有 TTY，弹授权框就永远卡住
  [ -t 1 ] || NO_OSA=1

  # 单实例：上一轮还没跑完就跳过，避免两轮同时补救打架
  if ! acquire_lock; then
    [ $quiet -eq 0 ] && info "上一轮看护还在跑，本轮跳过"
    return 0
  fi
  # 信号只负责"退出"，清理交给 EXIT：否则 INT/TERM 后进程会带着失效的锁继续跑
  # EXIT 里必须先验令牌：老版本无条件 rm -rf，会把**抢到锁的下一轮**的锁删掉，
  # 于是第三个实例立刻并发进场（这就是"锁被自己人砸开"）
  trap 'if lock_is_mine; then rm -rf "$LOCKD"; fi' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  while :; do
    rc=0
    now=$(date +%s)
    lock_touch                    # 续命：常驻实例跑过 LOCK_STALE 也不会被当陈旧锁回收
    devlist=$(list_devices 2>/dev/null)   # 每轮只取一次，别在循环里反复调 CLI

    while IFS=$'\t' read -r name _ port _ _; do
      case "${name:-}" in ''|\#*) continue;; esac
      [ -n "${port:-}" ] || continue

      if chan_ok "$port"; then
        read -r fails last < <(watch_state "$name")
        if [ "${fails:-0}" -gt 0 ] 2>/dev/null; then
          wlog "$name :$port 通路恢复（此前连续失败 ${fails} 次）"
          [ $quiet -eq 0 ] && ok "$name :$port 通路恢复"
          # 通路是它自己好的（不是我们 try_open 出来的）⇒ 旧 ssh 仍挂在死 socket 上。
          # 这种进程不报错、不退、KeepAlive 不触发，光"通路通了"并不会让它重连，
          # 必须趁这一轮踢一次。稳态（fails==0）绝不踢，否则每轮都在踢死好隧道。
          kick_tunnels "$name"
        fi
        # 成功时把 last_attempt 一起清零：退避只该由"补救过但没成功"来触发，
        # 否则刚恢复时又会因为"上次成功很近"把下一次真实断线的首修推迟一整个退避窗
        watch_put "$name" 0 0
        continue
      fi

      # 破坏性动作（term open + 踢隧道）不能建在一次 6s 采样上：UU 偶发抖动就误踢，
      # 反而把本来好好的隧道踢成断线。隔 2s 再采一次，两次都失败才认定真断。
      sleep 2
      if chan_ok "$port"; then
        wlog "$name :$port 首采失败、复采正常（抖动）→ 本轮不动手"
        continue                      # 不写状态：抖动不计入连续失败
      fi

      read -r fails last < <(watch_state "$name")
      fails=${fails:-0}
      # 退避判据用"已动手且失败"的次数：fails 只在真正 try_open 之后才 +1。
      # 老版本在这里先 +1 再比 -ge 3，等于把"待尝试"的那次也算进去，实际只试 2 次；
      # 而且离线/名字写错的分支也跟着 +1，设备回网后要白等一整个 15 分钟退避窗。
      gap=0; [ "$fails" -ge 3 ] && gap=900
      if [ "${last:-0}" -gt 0 ] && [ $(( now - last )) -lt "$gap" ]; then
        # 不动 last —— 它是"上次真正尝试"的时刻，退避基准不能漂
        watch_put "$name" "$fails" "$last"
        [ $quiet -eq 0 ] && info "$name :$port 仍不通（已尝试补救 $fails 次），退避中"
        # 只在刚跨过阈值那一次落日志：断网整夜时日志里必须留一条"它在退避"，
        # 否则 launchd 把 stdout 丢掉，运维看到的是一片空白，会误判成看护没在跑
        [ "$fails" -eq 3 ] && wlog "$name :$port 连续 $fails 次补救失败，转入 15 分钟退避"
        continue
      fi

      # 先看 UU 自己的设备状态再决定要不要动手。这里必须区分三种情况，
      # 否则"配置里名字写错"会被误报成"设备离线"，人就会一直等一台不存在的机器。
      if [ -n "${devlist:-}" ]; then
        if ! printf '%s\n' "$devlist" | awk -F'\t' -v n="$name" 'tolower($1)==tolower(n){f=1}END{exit !f}'; then
          wlog "$name :$port 不通，且 UU 设备列表里查无此设备（名字写错？）→ 跳过"
          [ $quiet -eq 0 ] && warn "$name 不在 UU 设备列表里，检查 devices.tsv 的名字"
          # 没真正尝试过：既不加 fails（否则名字写错几十轮后会触发退避），
          # 也不写 last（设备一旦回来应当立刻重试，而不是等退避窗走完）
          watch_put "$name" "$fails" "$last"
          continue
        fi
        if ! printf '%s\n' "$devlist" | awk -F'\t' -v n="$name" 'tolower($1)==tolower(n)&&$3=="1"{f=1}END{exit !f}'; then
          wlog "$name :$port 不通，且该设备在 UU 里显示离线 → 不尝试自愈"
          [ $quiet -eq 0 ] && warn "$name 设备离线，等它回来"
          # 离线不是"补救失败"，不计入 fails：设备回网后应立刻首修，不排队等退避
          watch_put "$name" "$fails" "$last"
          continue
        fi
      else
        # 取不到设备列表（CLI 超时/客户端异常）≠ 设备离线，别因此放弃补救
        wlog "$name :$port 不通，且 uu device list 无输出（CLI 异常）→ 仍尝试自愈"
      fi

      # 动手前再确认一次锁还是自己的：万一被抢走，宁可本轮什么都不做
      if ! lock_still_mine; then
        wlog "$name :$port 待自愈，但锁已易主（检测到并发实例）→ 本轮放弃"
        [ $quiet -eq 0 ] && warn "锁已易主，本轮放弃自愈"
        continue
      fi

      # 先拿 id 再动手：拿不到就别踢隧道（否则隧道被重启、自愈却根本没执行）
      id=$(printf '%s\n' "${devlist:-}" | awk -F'\t' -v w="$name" 'tolower($1)==tolower(w){print $2; exit}')
      if [ -z "${id:-}" ]; then
        wlog "$name :$port 不通，但解析不出设备 id（uu device list 取不到）→ 本轮不动手"
        [ $quiet -eq 0 ] && warn "$name 拿不到设备 id，先不动隧道"
        watch_put "$name" "$fails" "$last"
        continue
      fi
      # 到这里才真是"要动手了"：此时才 +1，失败计数只反映真实的补救尝试
      fails=$(( fails + 1 ))
      [ $quiet -eq 0 ] && warn "$name :$port 不通（第 $fails 次补救），开始自愈"
      wlog "$name :$port 不通（第 $fails 次补救），开始自愈"
      if try_open "$name" "$port" "$id"; then
        # 顺序很重要：通路确认活了再踢旧隧道。反过来踢，新连会打在还没恢复的端口上，
        # 白耗一轮 launchd 重启配额（甚至触发 crash-throttle）。
        kick_tunnels "$name"
        wlog "  自愈成功"
        [ $quiet -eq 0 ] && ok "$name :$port 自愈成功"
        watch_put "$name" 0 0
      else
        wlog "  自愈失败（对端掉线或 sshd 未运行）"
        [ $quiet -eq 0 ] && warn "$name :$port 自愈失败"
        watch_put "$name" "$fails" "$now"
        rc=3
      fi
    done < <(grep -v '^[[:space:]]*#' "$CFG" 2>/dev/null || true)

    mkdir -p "$(dirname "$LASTF")" && printf '%s\n' "$now" >"$LASTF" 2>/dev/null
    [ $once -eq 1 ] && break
    # 用 sleep & wait：前台 sleep 期间 bash 不执行 trap，TERM 会拖到 sleep 结束
    sleep 60 & wait $!
  done
  return $rc
}

watch_install() {
  local self pl
  self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  pl="$WATCH_PLIST"
  mkdir -p "$(dirname "$pl")" "$(dirname "$STATE")"
  cat >"$pl" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$WATCH_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$self</string>
    <string>watch</string>
    <string>--once</string>
    <string>--quiet</string>
  </array>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardErrorPath</key><string>$WERR</string>
</dict>
</plist>
EOF
  if [ ! -f "$TUNNELS" ]; then
    cat >"$TUNNELS" <<'EOF'
# 哪条通路挂了，就该重启哪些常驻隧道。格式：设备名<TAB>launchd 标签
# 例：office-pc	com.example.mac-reverse-tunnel
EOF
  fi
  launchctl bootout "gui/$(id -u)/$WATCH_LABEL" 2>/dev/null
  if launchctl bootstrap "gui/$(id -u)" "$pl"; then
    ok "看护已启用：${pl}（每 60s 一轮，日志 ${WLOG}）"
    info "记得在 ${TUNNELS} 里登记依赖隧道，否则只会修通路、不会重启隧道"
  else
    die "bootstrap 失败：launchctl bootstrap gui/$(id -u) $pl"
  fi
}

watch_uninstall() {
  launchctl bootout "gui/$(id -u)/$WATCH_LABEL" 2>/dev/null
  rm -f "$WATCH_PLIST"
  ok "看护已停用（$WATCH_PLIST 已删）"
}

# ---------- 入口 ----------
ensure_cfg
case "${1:-check}" in
  list)  cmd_list ;;
  check|status) cmd_check "${2:-}" ;;
  up)    shift; cmd_up "$@" ;;
  down)  shift; cmd_down "$@" ;;
  ssh)   shift; cmd_ssh "$@" ;;
  watch) shift; cmd_watch "$@" ;;
  -h|--help|help) sed -n '2,/^set -uo pipefail/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//' ;;
  *) die "未知子命令：$1（试试 uulink help）" ;;
esac
